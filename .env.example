# copy to .env and fill in what you need. .env is gitignored, never commit it.

# port for the web app and API
# PORT=8787

# F1 TV subscription token, for real car positions in live sessions.
# see README "Linking F1 TV". it expires every few days.
# F1TV_TOKEN=

# where MultiViewer's local API is (this is its default)
# MULTIVIEWER_URL=http://localhost:10101/api/graphql

# let other devices (phone, tablet, another PC) open and control the onboard
# windows on this machine. off by default.
# PITWALL_REMOTE_CONTROL=1
